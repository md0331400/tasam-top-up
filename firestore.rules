rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the caller signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is the caller an admin? (reads role from /users/{uid})
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: doc belongs to the caller
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /* ----------------------------- USERS ----------------------------- */
    match /users/{userId} {
      // Anyone signed in can create their own profile doc
      allow create: if isOwner(userId);
      // Owner can read own doc; admin can read any user
      allow read: if isOwner(userId) || isAdmin();

      // SECURITY: a normal user may ONLY update their own name/phone.
      // They can NEVER change their own role or walletBalance.
      allow update: if isOwner(userId)
        && !('role' in request.resource.data)
        && !('walletBalance' in request.resource.data)
        && !('totalSpent' in request.resource.data);

      // Admin can update any user doc (role, balance, etc.)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ----------------------------- PHONE INDEX ----------------------------- */
    // Enforces phone-number uniqueness at the DB level.
    //   • Doc id = normalized phone number.
    //   • A create fails if a doc with that phone already exists → duplicate blocked.
    match /phoneIndex/{phone} {
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/phoneIndex/$(phone))
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    /* ----------------------------- PRODUCTS ----------------------------- */
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ----------------------------- GAMES ----------------------------- */
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ----------------------------- ORDERS ----------------------------- */
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ----------------------------- TRANSACTIONS ----------------------------- */
    match /transactions/{txnId} {
      allow create: if isSignedIn()
        && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    /* ----------------------------- DEPOSITS ----------------------------- */
    match /deposits/{depositId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ----------------------------- NOTIFICATIONS ----------------------------- */
    // New model: targetType = "all" (global) or "user" (targetUserId = uid).
    // Legacy model (backward-compat): userId = "all" or userId = uid.
    match /notifications/{notifId} {
      allow create: if isAdmin();
      allow read: if isSignedIn()
        && (resource.data.targetType == 'all'
            || resource.data.targetUserId == request.auth.uid
            || resource.data.userId == 'all'
            || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ----------------------------- NOTIFICATION READS ----------------------------- */
    // Per-user read state. Doc id = "{notifId}_{userId}".
    // A user can only create/read/update their OWN read doc.
    match /notificationReads/{readId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    /* ----------------------------- ADMIN DEVICES ----------------------------- */
    // Device-key authorization for the admin panel.
    // Only an existing admin can create/read/update/delete device records.
    match /adminDevices/{deviceKey} {
      allow read, create, update, delete: if isAdmin();
    }

    /* ----------------------------- ADMIN LOGS ----------------------------- */
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    /* ----------------------------- VERIFICATION LOGS ----------------------------- */
    match /verificationLogs/{logId} {
      allow read, write: if isAdmin();
    }

    /* ----------------------------- BALANCE AUDIT ----------------------------- */
    match /balanceLogs/{logId} {
      allow read, write: if isAdmin();
    }

    /* ----------------------------- SETTINGS ----------------------------- */
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
